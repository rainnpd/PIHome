class Pager(Gtk.Fixed):
    """分页容器。

    子页面会按 (页号-当前页)*页宽 摆在两侧，绝对坐标很大；如果让 Gtk.Fixed
    把这些算进自然尺寸，整个窗口会被撑到上万像素宽（dock 直接飞出屏幕）。
    这里强制自然尺寸为 1，由父容器按窗口大小分配，超出部分交给窗口裁剪。
    """

    def do_get_preferred_width(self):
        return 1, 1

    def do_get_preferred_height(self):
        return 1, 1


class HomeScreen:
    def __init__(self, ls):
        self.ls = ls
        self.apps = load_apps()
        self.groups = group_apps(self.apps)
        self.app_by_id = {ai.get_id(): ai for ai in self.apps}
        self.icons = IconCache()
        self.recent = load_recent()   # 「常用」页：最近启动在前
        self.per_page = RECENT_FALLBACK
        self.label_px = load_font_px()
        self.dialog = None

        self.page = 0
        self.pages = 1
        self._last_size = (0, 0)
        self._rebuild_pending = False
        self._last_launch = {}
        self._toast_timer = None
        self._press_x = None
        self._press_y = None
        self.hit_items = []          # 底部 dock 的命中区
        self.page_hits = {}          # {页码: (分类名, [(控件, appinfo)])}

        # 壁纸放独立窗口（background 层）：静态画面由合成器缓存，
        # 翻页/拖动时只需要重绘图标层，不用每帧重新缩放整张壁纸。
        self.wallwin = Gtk.Window()
        self.wallwin.set_decorated(False)
        self.wallwin.set_app_paintable(True)
        self.wallwin.set_visual(Gdk.Screen.get_default().get_rgba_visual())
        self.ls.setup(self.wallwin, self.ls.BACKGROUND, self.ls.KB_NONE)
        self.bgimg = Gtk.Image()
        self.wallwin.add(self.bgimg)
        self._wall_size = (0, 0)
        self.wallwin.connect("size-allocate", self._on_wall_alloc)

        # 主屏本身是透明窗口，叠在壁纸窗口之上（bottom 层，仍低于普通窗口）
        self.win = Gtk.Window()
        self.win.set_decorated(False)
        self.win.set_resizable(True)
        self.win.set_app_paintable(True)
        self.win.set_visual(Gdk.Screen.get_default().get_rgba_visual())
        self.ls.setup(self.win, self.ls.BOTTOM, self.ls.KB_NONE)

        self.root = Gtk.EventBox()
        self.root.set_visible_window(True)   # 需要有窗口才能收到指针/触摸事件
        self.root.set_name("ah-root")
        self.win.add(self.root)

        self.overlay = Gtk.Overlay()
        self.root.add(self.overlay)

        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.content.set_hexpand(True)
        self.content.set_vexpand(True)
        self.content.set_margin_top(12)
        self.content.set_margin_bottom(6)
        self.overlay.add_overlay(self.content)

        self.catlabel = Gtk.Label(label="")
        self.catlabel.set_halign(Gtk.Align.START)
        self.catlabel.set_margin_start(30)
        self.catlabel.set_margin_bottom(2)
        self.catlabel.get_style_context().add_class("ah-cat")
        self.content.pack_start(self.catlabel, False, False, 0)

        # 分页容器：自己实现滑动，让页面实时跟手（Stack 只能整页动画，慢半拍）
        self.pager = Pager()
        self.pager.set_hexpand(True)
        self.pager.set_vexpand(True)
        self.content.pack_start(self.pager, True, True, 0)

        # 拖动状态
        self._shift = 0.0        # 当前页面横向偏移(像素)
        self._page_w = 1         # 一页的宽度
        self._dragging = False
        self._anim_id = None
        self._active_touches = 0
        self._touch_cancel = False
        self._mouse_down = False
        self._layout_pending = False

        self.dotsbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        self.dotsbox.set_halign(Gtk.Align.CENTER)
        self.content.pack_start(self.dotsbox, False, False, 4)

        self.dock = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=22)
        self.dock.set_halign(Gtk.Align.CENTER)
        self.content.pack_start(self.dock, False, False, 8)

        # 点击后的即时反馈条
        self.toast = Gtk.Label(label="")
        self.toast.get_style_context().add_class("ah-toast")
        self.toast.set_halign(Gtk.Align.CENTER)
        self.toast.set_valign(Gtk.Align.END)
        self.toast.set_margin_bottom(110)
        self.toast.set_no_show_all(True)
        self.overlay.add_overlay(self.toast)

        self._apply_css()
        self._load_wallpaper(1024, 740)

        self.win.connect("size-allocate", self._on_alloc)

        # 交互：Wayland 触摸不会产生 motion-notify，而且 Gesture 一旦 claim 序列
        # 就会把其它处理器全部挡掉（GestureDrag 和 MultiPress 无法共存）。
        # 所以直接处理 GDK 触摸事件；鼠标（VNC/远程）走 button/motion 事件。
        self.root.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.TOUCH_MASK)
        self.root.connect("touch-event", self._on_touch)
        self.root.connect("button-press-event", self._on_button_press)
        self.root.connect("button-release-event", self._on_button_release)
        self.root.connect("motion-notify-event", self._on_motion)

        self.build()

