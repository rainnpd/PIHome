# ---------------- layer-shell (ctypes) ----------------
class LayerShell:
    BACKGROUND, BOTTOM, TOP, OVERLAY = 0, 1, 2, 3
    LEFT, RIGHT, EDGE_TOP, EDGE_BOTTOM = 0, 1, 2, 3
    KB_NONE, KB_EXCLUSIVE, KB_ON_DEMAND = 0, 1, 2

    def __init__(self):
        self.lib = ctypes.CDLL("libgtk-layer-shell.so.0", use_errno=True)
        self.lib.gtk_layer_init_for_window.argtypes = [ctypes.c_void_p]
        self.lib.gtk_layer_set_layer.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.lib.gtk_layer_set_anchor.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
        self.lib.gtk_layer_set_exclusive_zone.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.lib.gtk_layer_set_keyboard_mode.argtypes = [ctypes.c_void_p, ctypes.c_int]

    def setup(self, win, layer, keyboard, exclusive=0):
        ptr = ctypes.c_void_p(hash(win))
        self.lib.gtk_layer_init_for_window(ptr)
        self.lib.gtk_layer_set_layer(ptr, layer)
        for e in (self.LEFT, self.RIGHT, self.EDGE_TOP, self.EDGE_BOTTOM):
            self.lib.gtk_layer_set_anchor(ptr, e, 1)
        self.lib.gtk_layer_set_exclusive_zone(ptr, exclusive)
        self.lib.gtk_layer_set_keyboard_mode(ptr, keyboard)


# ---------------- 应用与图标 ----------------
def load_apps():
    apps = []
    for ai in Gio.AppInfo.get_all():
        if not isinstance(ai, Gio.DesktopAppInfo):
            continue
        try:
            if not ai.should_show():
                continue
            if not ai.get_display_name():
                continue
        except Exception:
            continue
        apps.append(ai)
    apps.sort(key=lambda a: (a.get_display_name() or "").casefold())
    return apps


def category_of(ai):
    try:
        cats = set(x for x in (ai.get_categories() or "").split(";") if x)
    except Exception:
        cats = set()
    for name, keys in CATEGORY_RULES:
        if cats & keys:
            return name
    return "系统"


def group_apps(apps):
    buckets = {k: [] for k in CATEGORY_ORDER}
    for ai in apps:
        buckets[category_of(ai)].append(ai)
    return [(k, buckets[k]) for k in CATEGORY_ORDER if buckets[k]]


def load_recent():
    """读取「常用」页的桌面文件 id 列表，最近的在前。"""
    try:
        with open(RECENT_FILE) as f:
            data = json.load(f)
        if isinstance(data, list):
            return [str(x) for x in data]
    except Exception:
        pass
    return []


def save_recent(ids):
    try:
        d = os.path.dirname(RECENT_FILE)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        tmp = RECENT_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(ids, f)
        os.replace(tmp, RECENT_FILE)
    except Exception as e:
        log("save recent failed", repr(e))


class IconCache:
    def __init__(self):
        self.theme = Gtk.IconTheme.get_default()
        self.cache = {}

    def for_app(self, ai, size):
        key = (ai.get_id(), size)
        if key in self.cache:
            return self.cache[key]
        pb = None
        gicon = ai.get_icon()
        if gicon is not None:
            try:
                info = self.theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE)
                if info:
                    pb = info.load_icon()
            except Exception:
                pb = None
        if pb is None:
            pb = self.named("application-x-executable", size)
        self.cache[key] = pb
        return pb

    def named(self, name, size):
        key = (name, size)
        if key in self.cache:
            return self.cache[key]
        pb = None
        try:
            info = self.theme.lookup_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
            if info:
                pb = info.load_icon()
        except Exception:
            pb = None
        self.cache[key] = pb
        return pb


def cover_pixbuf(path, w, h):
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file(path)
    except Exception as e:
        log("wallpaper load failed:", path, e)
        return None
    if w <= 0 or h <= 0 or pb is None:
        return None
    pw, ph = pb.get_width(), pb.get_height()
    s = max(w / pw, h / ph)
    nw, nh = max(w, int(pw * s + 0.5)), max(h, int(ph * s + 0.5))
    pb2 = pb.scale_simple(nw, nh, GdkPixbuf.InterpType.BILINEAR)
    if pb2 is None:
        return None
    ox, oy = (nw - w) // 2, (nh - h) // 2
    if nw > w or nh > h:
        return pb2.new_subpixbuf(ox, oy, w, h)
    return pb2


def wallpaper_path():
    # 优先用 ~/.config/android-home/wallpaper（里面只写一行图片路径），
    # 没有就沿用 pcmanfm 的桌面配置，最后退回系统默认壁纸。
    for candidate in (CUSTOM_WALLPAPER, PCMANFM_DESKTOP_CONF):
        try:
            if candidate == CUSTOM_WALLPAPER:
                with open(candidate) as f:
                    p = f.readline().strip().strip('"')
            else:
                p = ""
                with open(candidate) as f:
                    for line in f:
                        if line.startswith("wallpaper="):
                            p = line.split("=", 1)[1].strip().strip('"')
                            break
            if p and os.path.exists(p):
                return p
        except Exception:
            pass
    return WALLPAPER_FALLBACK


def draw_home_icon(size):
    """画一个纯白色的“房子”图标：不依赖图标主题，白底壁纸上也清晰。"""
    try:
        import cairo
    except Exception as e:
        log("cairo unavailable", repr(e))
        return None
    s = float(size)
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    ctx = cairo.Context(surf)
    ctx.set_source_rgba(1, 1, 1, 0.96)
    # 屋顶 + 屋身（一笔画出的轮廓）
    ctx.move_to(s * 0.50, s * 0.12)
    ctx.line_to(s * 0.90, s * 0.47)
    ctx.line_to(s * 0.78, s * 0.47)
    ctx.line_to(s * 0.78, s * 0.86)
    ctx.line_to(s * 0.22, s * 0.86)
    ctx.line_to(s * 0.22, s * 0.47)
    ctx.line_to(s * 0.10, s * 0.47)
    ctx.close_path()
    ctx.fill()
    # 门镂空
    ctx.set_operator(cairo.OPERATOR_CLEAR)
    ctx.rectangle(s * 0.43, s * 0.64, s * 0.14, s * 0.22)
    ctx.fill()
    ctx.set_operator(cairo.OPERATOR_OVER)
    return Gdk.pixbuf_get_from_surface(surf, 0, 0, size, size)


def draw_gear_icon(size):
    """画一个白色齿轮（设置）：不依赖图标主题。"""
    try:
        import cairo
    except Exception as e:
        log("cairo unavailable", repr(e))
        return None
    s = float(size)
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    ctx = cairo.Context(surf)
    ctx.set_source_rgba(1, 1, 1, 0.96)
    c = s / 2.0
    for i in range(8):
        ctx.save()
        ctx.translate(c, c)
        ctx.rotate(i * math.pi / 4)
        ctx.rectangle(-s * 0.075, -s * 0.46, s * 0.15, s * 0.15)
        ctx.fill()
        ctx.restore()
    ctx.arc(c, c, s * 0.34, 0, 2 * math.pi)
    ctx.fill()
    ctx.set_operator(cairo.OPERATOR_CLEAR)
    ctx.arc(c, c, s * 0.14, 0, 2 * math.pi)
    ctx.fill()
    ctx.set_operator(cairo.OPERATOR_OVER)
    return Gdk.pixbuf_get_from_surface(surf, 0, 0, size, size)


def read_int_file(path, default, lo, hi):
    try:
        with open(path) as f:
            v = int(f.readline().strip())
        return max(lo, min(hi, v))
    except Exception:
        return default


def write_text_file(path, text):
    try:
        d = os.path.dirname(path)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, path)
        return True
    except Exception as e:
        log("write failed", path, repr(e))
        return False


def load_font_px():
    return read_int_file(FONT_FILE, FONT_DEFAULT, 8, 32)


def load_idle_sec():
