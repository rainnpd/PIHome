    return out


def thumb_path(path):
    h = hashlib.md5(path.encode()).hexdigest()[:12]
    return os.path.join(THUMB_DIR, h + ".png")


def make_thumb(path):
    """生成/复用缩略图：46 张 4K 原图直接解码太慢，缓存成小 PNG。"""
    tp = thumb_path(path)
    if os.path.exists(tp):
        return tp
    pb = cover_pixbuf(path, THUMB_W, THUMB_H)
    if pb is None:
        return None
    try:
        os.makedirs(THUMB_DIR, exist_ok=True)
        tmp = tp + ".tmp"
        pb.savev(tmp, "png", [], [])
        os.replace(tmp, tp)
    except Exception as e:
        log("thumb save failed", path, repr(e))
        return None
    return tp


def ensure_display():
    """手工/异常方式启动时补齐 DISPLAY，否则 X11 应用会报 Missing X server。"""
    if os.environ.get("DISPLAY"):
        return
    try:
        for name in sorted(os.listdir("/tmp/.X11-unix")):
            if not name.startswith("X"):
                continue
            path = os.path.join("/tmp/.X11-unix", name)
            if os.stat(path).st_uid != os.getuid():
                continue
            os.environ["DISPLAY"] = ":" + name[1:]
            os.environ.setdefault(
                "XAUTHORITY", os.path.join(os.path.expanduser("~"), ".Xauthority"))
            log("display ->", os.environ["DISPLAY"])
            return
    except Exception as e:
        log("display detect failed", e)


