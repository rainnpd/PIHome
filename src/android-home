            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # 图标字体大小单独一个 provider，改字号时只需重新加载它
        self._font_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self._font_css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self._load_font_css()

    def _load_font_css(self):
        try:
            self._font_css.load_from_data(
                (".ah-label { font-size: %dpx; }" % self.label_px).encode())
        except Exception as e:
            log("font css failed", repr(e))

    def _load_wallpaper(self, w, h):
        if os.environ.get("AH_DEBUG_SOLID"):
            pb = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, 8, 8)
            pb.fill(0x00a040ff)
            self.bgimg.set_from_pixbuf(pb)
            self._wp_sig = None
            return
        p = wallpaper_path()
        try:
            self._wp_sig = (p, os.stat(p).st_mtime, w, h)
        except Exception:
            self._wp_sig = (p, 0, w, h)
        pb = cover_pixbuf(p, w, h)
        log("wallpaper:", p, pb is not None)
        if pb is not None:
            self.bgimg.set_from_pixbuf(pb)

    def _on_wall_alloc(self, _w, alloc):
        size = (alloc.width, alloc.height)
        if size[0] <= 1 or size[1] <= 1 or size == self._wall_size:
            return
        self._wall_size = size
        self.bgimg.set_hexpand(True)
        self.bgimg.set_vexpand(True)
        self._load_wallpaper(*size)

    def _watch_wallpaper(self):
        """壁纸文件被替换、~/.config/android-home/wallpaper 或字号改动时自动生效。"""
        px = load_font_px()
        if px != self.label_px:
            log("font size ->", px)
            self.label_px = px
            self._load_font_css()
            self._schedule_rebuild()

        w, h = self._wall_size if self._wall_size[0] > 1 else self._last_size
        if w <= 1:
            return True
        p = wallpaper_path()
        try:
            sig = (p, os.stat(p).st_mtime, w, h)
        except Exception:
            sig = (p, 0, w, h)
        if sig != getattr(self, "_wp_sig", None):
            log("wallpaper changed ->", p)
            self._load_wallpaper(w, h)
        return True

    # ---- 布局 ----
    def _on_alloc(self, widget, alloc):
        size = (alloc.width, alloc.height)
        if size == self._last_size or size[0] <= 1 or size[1] <= 1:
            return
        self._last_size = size
        log("alloc", size)
        self._schedule_rebuild()

    def _schedule_rebuild(self):
        if self._rebuild_pending:
            return
        self._rebuild_pending = True
        GLib.idle_add(self._do_rebuild)

    def _do_rebuild(self):
        self._rebuild_pending = False
        self.build()
        return False

    def _clear(self, box):
        for ch in list(box.get_children()):
            box.remove(ch)
            ch.destroy()

    def _recent_apps(self, per):
        """按最近使用顺序取「常用」页的应用；已卸载的跳过，超出一页的丢弃最旧。"""
        out = []
        for aid in self.recent:
            ai = self.app_by_id.get(aid)
            if ai is not None and ai not in out:
                out.append(ai)
            if len(out) >= per:
                break
        return out

    def _make_pages(self, per):
        pages = []
        fav = self._recent_apps(per)
        if fav:
            pages.append(("常用", fav))
        for cat, items in self.groups:
            for i in range(0, len(items), per):
                pages.append((cat, items[i:i + per]))
        return pages or [("应用", [])]

    def build(self):
        w, h = self._last_size
        if w <= 1 or h <= 1:
            w, h = 1024, 740
        avail_h = h - 150
        cols = max(3, min(6, w // 185))
        rows = max(2, min(5, avail_h // 158))
        per = cols * rows
        self.per_page = per
        # 启动记录只保留一页的量，多出来的（最旧的）直接丢掉
        if len(self.recent) > per:
            self.recent = self.recent[:per]
            save_recent(self.recent)
        pages = self._make_pages(per)
        self.pages = len(pages)
        if self.page >= self.pages:
            self.page = self.pages - 1

        self._build_pages(cols, rows, pages)
        self._build_dots()
        self._build_dock()
        self.content.show_all()
        self._apply_page(self.page, animate=False)
        log("build %dx%d cols=%d rows=%d pages=%d page=%d apps=%d"
            % (w, h, cols, rows, self.pages, self.page, len(self.apps)))

    def _build_pages(self, cols, rows, pages):
        self._stop_anim()
        # 彻底销毁旧子项：只 remove 不 destroy 会在重建后留下同名隐藏实例，
        # 命中测试就会指向那份不可见的副本(尺寸 1x1)，表现为点不动。
        for ch in list(self.pager.get_children()):
            self.pager.remove(ch)
            ch.destroy()
        self.page_hits = {}

        w, h = self._last_size
        if w <= 1:
            w, h = 1024, 740
        avail_h = max(100, h - 150)
        self._page_w = w
        self._shift = 0.0
        cell_h = max(80, avail_h // rows)
        cell_w = max(80, w // cols)
        icon_sz = int(min(cell_w * 0.52, cell_h * 0.56, ICON_MAX))

        for pno, (cat, chunk) in enumerate(pages):
            grid = Gtk.Grid()
            grid.set_row_homogeneous(True)
            grid.set_column_homogeneous(True)
            grid.set_size_request(w, cell_h * rows)
            hits = []
            for idx, ai in enumerate(chunk):
                col, row = idx % cols, idx // cols
                cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                cell.set_hexpand(True)
                cell.set_vexpand(True)
                inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
                inner.set_halign(Gtk.Align.CENTER)
                inner.set_valign(Gtk.Align.CENTER)
                img = Gtk.Image()
                img.set_halign(Gtk.Align.CENTER)
                pb = self.icons.for_app(ai, icon_sz)
                if pb is not None:
                    img.set_from_pixbuf(pb)
                lbl = Gtk.Label(label=ai.get_display_name())
                lbl.set_ellipsize(Pango.EllipsizeMode.END)
                lbl.set_max_width_chars(14)
                lbl.set_justify(Gtk.Justification.CENTER)
                lbl.set_halign(Gtk.Align.CENTER)
                lbl.get_style_context().add_class("ah-label")
                inner.pack_start(img, False, False, 0)
                inner.pack_start(lbl, False, False, 0)
                cell.pack_start(inner, True, True, 0)
                grid.attach(cell, col, row, 1, 1)
                hits.append((cell, ai))
            # 所有页都放进 Fixed，按 (页号-当前页)*页宽 摆放，拖动时实时平移
            self.pager.put(grid, (pno - self.page) * w, 0)
            grid.show_all()
            self.page_hits[pno] = (cat, hits, grid)
        self._position_pages()

    def _position_pages(self):
        """全量摆放（重建/翻页结束时用一次）。"""
        for pno, (_cat, _hits, grid) in self.page_hits.items():
            x = (pno - self.page) * self._page_w + self._shift
            self.pager.move(grid, int(round(x)), 0)

    def _slide_pages(self):
        """拖动过程中只移动当前页和左右相邻页，其余页留在原地。

        触摸事件可达 60~120Hz，若每帧把 9 个页面都重排/重绘，CPU 会被打满，
        画面就开始掉帧卡顿。
        """
        for pno in range(max(0, self.page - 1), min(self.pages, self.page + 2)):
            entry = self.page_hits.get(pno)
            if entry is None:
                continue
            x = (pno - self.page) * self._page_w + self._shift
            self.pager.move(entry[2], int(round(x)), 0)

    def _schedule_slide(self):
        """把触摸位移合并到下一帧，并限制最高刷新率，避免 CPU 被重绘打满。"""
        if self._layout_pending:
            return
        self._layout_pending = True
        wait = MIN_FRAME_S - (time.monotonic() - getattr(self, "_last_slide", 0.0))
        if wait <= 0.002:
            GLib.idle_add(self._flush_slide)
        else:
            GLib.timeout_add(int(wait * 1000) + 1, self._flush_slide)

    def _flush_slide(self):
        self._layout_pending = False
        self._last_slide = time.monotonic()
        self._slide_pages()
        return False

    def _stop_anim(self):
        if self._anim_id is not None:
            GLib.source_remove(self._anim_id)
            self._anim_id = None

    def _animate_shift(self, target, done=None):
        """把偏移量缓动到 target（松手后的翻页/回弹）。"""
        self._stop_anim()
        start = self._shift
        dur = SLIDE_MS / 1000.0
        t0 = time.monotonic()

        def step():
            t = min(1.0, (time.monotonic() - t0) / dur)
            e = 1 - (1 - t) ** 3          # ease-out
            self._shift = start + (target - start) * e
            self._position_pages()
            if t >= 1.0:
                self._anim_id = None
                self._shift = 0.0
                if done:
                    done()
                self._position_pages()
                return False
            return True

        self._anim_id = GLib.timeout_add(16, step)

    def _apply_page(self, page, animate=True):
        """切换到指定页；相邻页滑动动画，跨页直接切。"""
        page = max(0, min(self.pages - 1, page))
        if page not in self.page_hits:
            return
        if not animate or abs(page - self.page) != 1:
            self._stop_anim()
            self.page = page
            self._shift = 0.0
            self._update_page_ui()
            self._position_pages()
        else:
            direction = -1 if page > self.page else 1
            self._animate_shift(direction * self._page_w,
                                lambda: self._finish_page(page))

    def _finish_page(self, page):
        self.page = page
        self._update_page_ui()
        self._position_pages()

    def _update_page_ui(self):
        cat = self.page_hits.get(self.page, ("",))[0]
        self.catlabel.set_text(cat)
        self._build_dots()
        log("apply_page", self.page, cat)

    def _build_dots(self):
        self._clear(self.dotsbox)
        if self.pages <= 1:
            return
        for i in range(self.pages):
            l = Gtk.Label(label="●")
            l.get_style_context().add_class("ah-dot-on" if i == self.page else "ah-dot")
            self.dotsbox.add(l)
            l.show()   # 翻页时重建的圆点必须显式 show，否则不显示

    def _icon_cell(self, ai, size, pixbuf=None):
        cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        cell.set_size_request(size + 22, size + 22)
        img = Gtk.Image()
        img.set_halign(Gtk.Align.CENTER)
        img.set_valign(Gtk.Align.CENTER)
        if pixbuf is not None:
            pb = pixbuf
        elif ai is not None:
            pb = self.icons.for_app(ai, size)
        else:
            pb = self.icons.named("input-keyboard", size)
        if pb is not None:
            img.set_from_pixbuf(pb)
        cell.pack_start(img, True, True, 0)
        return cell

    def _build_dock(self):
        self._clear(self.dock)
        self.hit_items = []
        holder = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24)
        holder.get_style_context().add_class("ah-dock")
        # 第三个应用之后插入“回到常用页”按钮（视觉上位于 dock 正中）
        before, after = DOCK_IDS[:3], DOCK_IDS[3:]
        entries = []
        for did in before:
            ai = self._find_app(did)
            if ai is not None:
                entries.append((ai, None))
        entries.append((None, "home"))
        for did in after:
            ai = self._find_app(did)
            if ai is not None:
                entries.append((ai, None))
        entries.append((None, "osk"))
        entries.append((None, "settings"))
        for ai, kind in entries:
            if kind == "home":
                cell = self._icon_cell(None, DOCK_ICON, draw_home_icon(DOCK_ICON))
            elif kind == "settings":
                cell = self._icon_cell(None, DOCK_ICON, draw_gear_icon(DOCK_ICON))
            else:
                cell = self._icon_cell(ai, DOCK_ICON)
            holder.add(cell)
            self.hit_items.append((cell, kind if kind else ai))
        self.dock.add(holder)
        holder.show_all()

    def _find_app(self, desktop_id):
        for a in self.apps:
            try:
                if a.get_id() in (desktop_id, desktop_id + ".desktop"):
                    return a
            except Exception:
                pass
        return None

    # ---- 交互 ----
    def _show_toast(self, text):
        self.toast.set_text(text)
        self.toast.show()
        if self._toast_timer is not None:
            GLib.source_remove(self._toast_timer)
        self._toast_timer = GLib.timeout_add(1800, self._hide_toast)

    def _hide_toast(self):
        self._toast_timer = None
        self.toast.hide()
        return False

    # ---- 触摸/鼠标交互 ----
    def _drag_start(self):
        if not self._dragging:
            self._dragging = True
            self._stop_anim()
            log("drag begin")

    def _drag_to(self, dx, dy):
        """返回 True 表示已进入拖动（页面跟手）。"""
        if not self._dragging:
            if abs(dx) < DRAG_START_PX or abs(dx) < abs(dy) * 1.2:
                return False
            self._drag_start()
        shift = dx
        if (self.page == 0 and shift > 0) or (self.page == self.pages - 1 and shift < 0):
            shift *= 0.35              # 首/末页阻尼
        self._shift = max(-self._page_w, min(self._page_w, shift))
        self._schedule_slide()
        return True

    def _drag_end(self):
        """松手：超过阈值或快速轻扫就翻页，否则回弹。"""
        self._dragging = False
        shift = self._shift
        threshold = max(50, self._page_w * SNAP_RATIO)
        elapsed = max(0.001, time.monotonic() - getattr(self, "_press_t", 0.0))
        fling = abs(shift) >= 40 and abs(shift) / elapsed >= 500
        # shift<0：页面被往左拖 -> 露出右边下一页；shift>0 -> 上一页
        target = self.page + (1 if shift < 0 else -1)
        target = max(0, min(self.pages - 1, target))
        if (abs(shift) >= threshold or fling) and target != self.page:
            log("page ->", target, "shift", int(shift), "fling", fling)
            self._animate_shift(-self._page_w if shift < 0 else self._page_w,
                                lambda: self._finish_page(target))
        else:
            log("page snap back", int(shift))
            self._animate_shift(0.0)

    def _tap_at(self, x, y):
        obj = self._hit_test(x, y)
        if obj == "osk":
            log("tap osk")
            self._on_osk_clicked(None)
        elif obj == "home":
            log("tap home -> page 0")
            self._apply_page(0, animate=True)
        elif obj == "settings":
            log("tap settings")
            self._open_settings()
        elif obj is not None:
            log("tap", x, y, "->", obj.get_id())
            self._on_app_clicked(None, obj)
        else:
            log("tap", x, y, "-> no hit")

    def _on_touch(self, _w, ev):
        et = ev.type
        if et == Gdk.EventType.TOUCH_BEGIN:
            self._active_touches += 1
            if self._active_touches > 1:
                # 多指（三指切窗口/四指键盘）：取消翻页，避免和手势守护进程打架
                self._touch_cancel = True
                if self._dragging:
                    self._dragging = False
                    self._animate_shift(0.0)
                return True
            self._touch_cancel = False
            self._press_x, self._press_y = ev.touch.x, ev.touch.y
            self._press_t = time.monotonic()
            self._dragging = False
            log("touch begin")
            return True

        if et == Gdk.EventType.TOUCH_UPDATE:
            if self._touch_cancel:
                return True
            dx = ev.touch.x - self._press_x
            dy = ev.touch.y - self._press_y
            self._drag_to(dx, dy)
            return True

        if et in (Gdk.EventType.TOUCH_END, Gdk.EventType.TOUCH_CANCEL):
            self._active_touches = max(0, self._active_touches - 1)
            if self._touch_cancel:
                if self._active_touches == 0:
                    self._touch_cancel = False
                    self._dragging = False
                    self._shift = 0.0
                    self._position_pages()
                return True
            if self._dragging:
                self._drag_end()
            else:
                self._tap_at(self._press_x, self._press_y)
            return True
        return False

    # ---- 鼠标（VNC / 远程调试）----
    def _on_button_press(self, _w, ev):
        if self._active_touches > 0:
            return False
        self._mouse_down = True
        self._press_x, self._press_y = ev.x, ev.y
        self._press_t = time.monotonic()
        self._dragging = False
        return False

    def _on_motion(self, _w, ev):
        if not self._mouse_down or self._active_touches > 0:
            return False
        return self._drag_to(ev.x - self._press_x, ev.y - self._press_y)

    def _on_button_release(self, _w, ev):
        if not self._mouse_down:
            return False
        self._mouse_down = False
        if self._dragging:
            self._drag_end()
        else:
            self._tap_at(ev.x, ev.y)
        return True

    def _origin_in_root(self, widget):
        """控件左上角在 root 坐标系里的位置。

        注意不要自己逐级累加 allocation：GTK3 里 GtkBox 分配子控件时
        allocation 已经带上了父级偏移(dock 里的图标会被重复计算父偏移，
        结果落到屏幕外 y=1856)，只有 GtkStack 这类才是相对坐标。
        一律交给 translate_coordinates 处理。
        """
        try:
            res = widget.translate_coordinates(self.root, 0, 0)
            # 不同 PyGObject 版本返回 (ok, x, y) 或 (x, y)
            if isinstance(res, tuple) and len(res) == 3:
                ok, tx, ty = res
            else:
                tx, ty = res
                ok = True
            if ok:
                return int(tx), int(ty)
        except Exception as e:
            log("translate failed", repr(e))
        # 兜底：取自身 allocation（Box 系子项在其中已是父窗口坐标系）
        a = widget.get_allocation()
        return a.x, a.y

    def _hit_test(self, x, y):
        # 先测当前页的图标，再测底部 dock
        hits = list(self.page_hits.get(self.page, ("", []))[1]) + list(self.hit_items)
        for widget, obj in hits:
            alloc = widget.get_allocation()
            ox, oy = self._origin_in_root(widget)
            if ox <= x < ox + alloc.width and oy <= y < oy + alloc.height:
                return obj
        return None

    def _on_app_clicked(self, _btn, ai):
        aid = ai.get_id()
        now = time.time()
        # 防抖：同一个应用连点会重复拉起多个实例（实测被点出 13 次）
        if now - self._last_launch.get(aid, 0.0) < LAUNCH_GAP:
            return
        self._last_launch[aid] = now
        name = ai.get_display_name() or aid
        self._show_toast("正在启动 %s…" % name)
        try:
            ai.launch([], None)
            log("launch", aid)
            self._remember(ai)
        except Exception as e:
            log("launch failed", aid, repr(e))
            self._show_toast("启动失败：%s" % name)

    def _remember(self, ai):
        """把刚启动的应用放到「常用」页最前，只保留一页的量。"""
        aid = ai.get_id()
        self.recent = [x for x in self.recent if x != aid]
        self.recent.insert(0, aid)
        per = max(1, self.per_page)
        del self.recent[per:]
        save_recent(self.recent)
        log("recent", ",".join(self.recent[:6]))
        self._schedule_rebuild()

    def _on_osk_clicked(self, _btn):
        try:
            subprocess.Popen(["/usr/local/bin/osk-toggle"])
        except Exception as e:
            log("osk-toggle failed", e)

    def _open_settings(self):
        if self.dialog is not None:
            self.dialog.present()
            return
        self.dialog = SettingsDialog(self)

    def run(self):
        self.win.connect("destroy", Gtk.main_quit)
        self.wallwin.show_all()
        self.win.show_all()
        log("shown %dx%d apps=%d pages=%d groups=%s"
            % (self.win.get_allocated_width(), self.win.get_allocated_height(),
               len(self.apps), self.pages,
               ",".join("%s:%d" % (k, len(v)) for k, v in self.groups)))
        GLib.timeout_add(6000, self._selfcheck)
        GLib.timeout_add(WP_POLL_MS, self._watch_wallpaper)
        Gtk.main()

    def _selfcheck(self):
        """布局完成后打印若干图标的实际命中区域，便于核对坐标是否正确。"""
        def name_of(o):
            return o if isinstance(o, str) else (o.get_id() if o is not None else None)

        items = list(self.page_hits.get(self.page, ("", []))[1])[:2] + list(self.hit_items[-2:])
        for w, obj in items:
            a = w.get_allocation()
            ox, oy = self._origin_in_root(w)
            log("selfcheck", name_of(obj), "origin", (ox, oy), "size", (a.width, a.height))

        # 命中链路自检：用每个 dock 图标的中心点跑一遍命中测试
        for w, obj in self.hit_items:
            a = w.get_allocation()
            ox, oy = self._origin_in_root(w)
            cx, cy = ox + a.width // 2, oy + a.height // 2
            got = self._hit_test(cx, cy)
            gname, expect = name_of(got), name_of(obj)
            log("hit", "at", (cx, cy), "->", gname, "expect", expect,
                "OK" if gname == expect else "MISMATCH")

        for label, widget in (("page", self._first_widget(False)),
                              ("dock", self._first_widget(True))):
            if widget is None:
                continue
            chain, cur = [], widget
            while cur is not None:
                a = cur.get_allocation()
                chain.append("%s(%d,%d %dx%d)" % (type(cur).__name__, a.x, a.y,
                                                  a.width, a.height))
                if cur is self.root:
                    break
                cur = cur.get_parent()
            log("chain", label, " <- ".join(chain))
        return False

    def _first_widget(self, dock):
        if dock:
            return self.hit_items[0][0] if self.hit_items else None
        items = self.page_hits.get(self.page, ("", []))[1]
        return items[0][0] if items else None


class SettingsDialog:
    """设置面板：背景图片 / 熄屏时间 / 图标字体大小。

    独立 OVERLAY 层窗口铺满整屏，点面板外的暗色区域关闭。
    先显示面板再逐张加载缩略图，避免一次解码 40+ 张 4K 壁纸把界面卡住。
    """

    def __init__(self, home):
        self.home = home
        self._pending = []
        self._wp_buttons = {}
        self._idle_buttons = {}
        self._font_buttons = []

        self.win = Gtk.Window()
        self.win.set_decorated(False)
        self.win.set_app_paintable(True)
        self.win.set_visual(Gdk.Screen.get_default().get_rgba_visual())
        home.ls.setup(self.win, home.ls.OVERLAY, home.ls.KB_NONE)

        dim = Gtk.EventBox()
        dim.set_visible_window(True)
        dim.set_name("ah-dim")
        self.win.add(dim)
        dim.connect("button-press-event", self._on_dim_press)

        panel = Gtk.EventBox()
        panel.set_visible_window(True)
        panel.set_name("ah-panel")
        panel.set_halign(Gtk.Align.CENTER)
        panel.set_valign(Gtk.Align.CENTER)
        panel.set_size_request(820, -1)
        panel.connect("button-press-event", self._on_panel_press)   # 面板内点击不关闭
        dim.add(panel)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(22)
        panel.add(box)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        title = Gtk.Label(label="设置")
        title.set_xalign(0)
        title.get_style_context().add_class("ah-st-title")
        head.pack_start(title, True, True, 0)
        close = self._pill("关闭")
        close.connect("button-press-event", lambda w, e: (self.close(), True)[1])
        head.pack_end(close, False, False, 0)
        box.pack_start(head, False, False, 0)

        # ---- 背景图片 ----
        box.pack_start(self._section("背景图片"), False, False, 0)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_size_request(-1, 292)
        sw.set_hexpand(True)
        flow = Gtk.FlowBox()
        flow.set_max_children_per_line(4)
        flow.set_min_children_per_line(4)
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_row_spacing(4)
        flow.set_column_spacing(4)
        flow.set_valign(Gtk.Align.START)
        sw.add(flow)
        box.pack_start(sw, False, False, 0)

        cur = os.path.abspath(wallpaper_path())
        for p in wallpaper_files():
            # 用 EventBox 而不是 Gtk.Button：按钮会带主题的下边框，和深色面板不搭
            tile = Gtk.EventBox()
            tile.set_visible_window(True)
            tile.get_style_context().add_class("ah-st-wp")
            vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            img = Gtk.Image()
            img.set_size_request(THUMB_W, THUMB_H)
            name = Gtk.Label(label=os.path.basename(p))
            name.get_style_context().add_class("ah-st-name")
            vb.pack_start(img, False, False, 0)
            vb.pack_start(name, False, False, 0)
            tile.add(vb)
            tile.connect("button-press-event", self._on_wallpaper_tap, p)
            flow.add(tile)
            self._wp_buttons[p] = tile
            self._pending.append((p, img))
            if os.path.abspath(p) == cur:
                tile.get_style_context().add_class("ah-st-wp-sel")
        self._sel_wp = cur
        self._sw = sw
        GLib.idle_add(self._scroll_to_sel)

        # ---- 熄屏时间 ----
        box.pack_start(self._section("熄屏时间"), False, False, 4)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self._sel_idle = load_idle_sec()
        for text, sec in IDLE_CHOICES:
            b = self._pill(text)
            b.connect("button-press-event", self._on_idle, sec)
            row.pack_start(b, False, False, 0)
            self._idle_buttons[sec] = b
            if sec == self._sel_idle:
                b.get_style_context().add_class("ah-st-sel")
        box.pack_start(row, False, False, 0)

        # ---- 图标字体 ----
        box.pack_start(self._section("桌面图标字体大小"), False, False, 4)
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self._sel_font = home.label_px
        for text, px in FONT_CHOICES:
            b = self._pill(text)
            b.connect("button-press-event", self._on_font, px)
            row2.pack_start(b, False, False, 0)
            self._font_buttons.append((px, b))
            if px == self._sel_font:
                b.get_style_context().add_class("ah-st-sel")
        box.pack_start(row2, False, False, 0)

        self.win.connect("destroy", self._on_destroy)
        self.win.show_all()
        GLib.idle_add(self._load_next_thumb)

    @staticmethod
    def _section(text):
        l = Gtk.Label(label=text)
        l.set_xalign(0)
        l.get_style_context().add_class("ah-st-sec")
        return l

    @staticmethod
    def _pill(text):
        """胶囊按钮：用 EventBox 承载，避免 GtkButton 的主题样式和事件吞掉问题。
        EventBox 不适用 CSS padding，改用 label 的外边距撑出内边距。"""
        eb = Gtk.EventBox()
        eb.set_visible_window(True)
        eb.get_style_context().add_class("ah-st-btn")
        l = Gtk.Label(label=text)
        l.set_margin_start(18)
        l.set_margin_end(18)
        l.set_margin_top(9)
        l.set_margin_bottom(9)
        eb.add(l)
        return eb

    def _load_next_thumb(self):
        if not self._pending:
            return False
        p, img = self._pending.pop(0)
        tp = make_thumb(p)
        if tp:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    tp, THUMB_W, THUMB_H, True)
                img.set_from_pixbuf(pb)
            except Exception as e:
                log("thumb load failed", repr(e))
        return True

    def _on_dim_press(self, _w, ev):
        if ev.button == 1:
            self.close()
            return True
        return False

    def _on_panel_press(self, _w, _ev):
        return True      # 面板内点击不关闭面板

    def _scroll_to_sel(self):
        b = self._wp_buttons.get(self._sel_wp)
        if b is None:
            return False
        y = b.get_allocation().y
        h = b.get_allocation().height
        adj = self._sw.get_vadjustment()
        top = adj.get_upper() - adj.get_page_size()
        # 让当前壁纸所在整行居中，避免只露出半行缩略图
        adj.set_value(max(0.0, min(top, y + h / 2.0 - adj.get_page_size() / 2.0)))
        return False

    def _on_wallpaper_tap(self, _w, ev, path):
        if ev.button != 1:
            return False
        log("wallpaper ->", path)
        write_text_file(CUSTOM_WALLPAPER, path + "\n")
        old = self._wp_buttons.get(self._sel_wp)
        if old is not None:
            old.get_style_context().remove_class("ah-st-wp-sel")
        self._sel_wp = os.path.abspath(path)
        self._wp_buttons[path].get_style_context().add_class("ah-st-wp-sel")
        w, h = self.home._wall_size
        if w <= 1:
            w, h = self.home._last_size
        if w > 1:
            self.home._load_wallpaper(w, h)
        self.home._show_toast("壁纸已切换")
        return True

    def _on_idle(self, _w, ev, sec):
        if ev.button != 1:
            return False
        write_text_file(IDLE_FILE, "%d\n" % sec)
        old = self._idle_buttons.get(self._sel_idle)
        if old is not None:
            old.get_style_context().remove_class("ah-st-sel")
        self._sel_idle = sec
        self._idle_buttons[sec].get_style_context().add_class("ah-st-sel")
        # lwrespawn 守护的 ah-idle 会用新时长把 swayidle 重新拉起
        try:
            subprocess.Popen(["pkill", "-x", "swayidle"])
        except Exception as e:
            log("restart swayidle failed", repr(e))
        return True

    def _on_font(self, _w, ev, px):
        if ev.button != 1:
            return False
        write_text_file(FONT_FILE, "%d\n" % px)
        for old_px, b in self._font_buttons:
            if old_px == self._sel_font:
                b.get_style_context().remove_class("ah-st-sel")
        self._sel_font = px
        for p, b in self._font_buttons:
            if p == px:
                b.get_style_context().add_class("ah-st-sel")
        self.home.label_px = px
        self.home._load_font_css()
        self.home._schedule_rebuild()
        return True

    def present(self):
        self.win.present()

    def close(self):
        self.win.destroy()

    def _on_destroy(self, _w):
        self.home.dialog = None


